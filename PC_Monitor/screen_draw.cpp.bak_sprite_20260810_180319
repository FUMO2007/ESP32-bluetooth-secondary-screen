#include "screen_draw.h"

TFT_eSPI tft = TFT_eSPI();

static HardwareData lastData;
static bool firstRun = true;
static int lastCpuWave[WAVE_POINTS] = {0};
static int lastGpuWave[WAVE_POINTS] = {0};

// ===================== 主题色 =====================
#define C_BG       0x0000   // 背景（黑）
#define C_TITLE1   0x18E3   // 标题栏渐变（上）
#define C_TITLE2   0x0821   // 标题栏渐变（下）
#define C_CARD     0x0C63   // 卡片背景（深蓝灰）
#define C_CARD_ED  0x2965   // 卡片内部线条
#define C_LABEL    0xBDF7   // 标签（浅灰）
#define C_VALUE    0xFFFF   // 数值（白）
#define C_CPU      0x7FE0   // CPU 主题（亮绿）
#define C_CPU_DIM  0x0460   // CPU 暗（边框/波形填充）
#define C_GPU      0xFB00   // GPU 主题（橙红）
#define C_GPU_DIM  0x8800   // GPU 暗
#define C_OK       0x07E0
#define C_WARN     0xFFE0
#define C_ALERT    0xF800
#define C_ORANGE   0xFD20
#define C_BAR_BG   0x0841   // 进度条底

// ===================== 布局 =====================
#define TITLE_H    24
#define CARD_Y     30
#define CARD_H     120
#define CARD_W     152
#define CPU_X      4
#define GPU_X      164
#define WAVE_Y     156
#define WAVE_H     44
#define BOT_Y1     206
#define BOT_Y2     226

String fmtValue(float v, int dec, const char* unit) {
  if (v <= 0) return "--";
  return String(v, dec) + unit;
}

// 显存显示为"已用/总量"（0 是有效值；负数表示读不到）
String fmtVram(float used, float total) {
  if (used < 0 || total < 0) return "--";
  return String(used, 1) + "/" + String(total, 1);
}

// 进度条颜色：按百分比 绿 -> 黄 -> 红
uint16_t barColor(float pct) {
  if (pct > 80) return C_ALERT;
  if (pct > 60) return C_WARN;
  return C_OK;
}

// 绘制进度条（x,y 左上角，w 宽，h 高，pct 百分比）
void drawBar(int x, int y, int w, int h, float pct) {
  int len = (int)(constrain(pct, 0, 100) * w / 100.0f);
  tft.fillRect(x, y, w, h, C_BAR_BG);
  if (len > 0) tft.fillRect(x, y, len, h, barColor(pct));
  tft.drawRect(x, y, w, h, C_CARD_ED);
}

// 在卡片内右对齐绘制数值（xRight 为右边界，y 为文字顶部）
void drawValue(int xRight, int y, const String &s, uint16_t color) {
  tft.setTextColor(color);
  tft.setTextSize(2);
  tft.drawString(s, xRight - tft.textWidth(s), y);
}

void screenInit() {
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(C_BG);
  tft.setTextColor(C_VALUE, C_BG);
  tft.setTextDatum(TL_DATUM);
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  memset(&lastData, 0, sizeof(HardwareData));
  memset(lastCpuWave, -1, sizeof(lastCpuWave));
  memset(lastGpuWave, -1, sizeof(lastGpuWave));

  drawStaticUI();
}

