  // ===== GPU 卡片 =====
  tft.fillRoundRect(GPU_X, CARD_Y, CARD_W, CARD_H, 6, C_CARD);
  tft.drawRoundRect(GPU_X, CARD_Y, CARD_W, CARD_H, 6, C_GPU_DIM);
  tft.setTextColor(C_GPU);
  tft.setTextSize(2);
  tft.drawString("GPU", GPU_X + 8, CARD_Y + 4);
  tft.setTextSize(1);
  tft.setTextColor(0x5AEB);
  tft.drawString("GRAPHICS", GPU_X + 52, CARD_Y + 10);
  tft.drawLine(GPU_X + 4, CARD_Y + 22, GPU_X + CARD_W - 4, CARD_Y + 22, C_CARD_ED);
  tft.setTextColor(C_LABEL);
  tft.setTextSize(1);
  tft.drawString("LOAD", GPU_X + 8, CARD_Y + 25);
  tft.drawString("TEMP", GPU_X + 8, CARD_Y + 61);
  tft.drawString("VRAM", GPU_X + 8, CARD_Y + 79);
  tft.drawString("PWR",  GPU_X + 8, CARD_Y + 97);

  // ===== 波形框 =====
  tft.fillRoundRect(CPU_X, WAVE_Y, CARD_W, WAVE_H, 6, C_CARD);
  tft.drawRoundRect(CPU_X, WAVE_Y, CARD_W, WAVE_H, 6, C_CPU_DIM);
  tft.fillRoundRect(GPU_X, WAVE_Y, CARD_W, WAVE_H, 6, C_CARD);
  tft.drawRoundRect(GPU_X, WAVE_Y, CARD_W, WAVE_H, 6, C_GPU_DIM);

  // ===== 底部标签 =====
  tft.setTextSize(1);
  tft.setTextColor(C_LABEL);
  tft.drawString("RAM",  CPU_X + 8, BOT_Y1);
  tft.drawString("DISK", CPU_X + 8, BOT_Y2);
  tft.drawString("FPS",  GPU_X + 12, BOT_Y2);
}

void drawWaveGraph(uint16_t x, uint16_t y, uint16_t w, uint16_t h,
                   int buf[], int lastBuf[], uint16_t color, uint16_t fillColor) {
  int drawX = x + 3;
  int drawY = y + 3;
  int drawW = w - 6;
  int drawH = h - 6;

  // 背景
  tft.fillRect(drawX, drawY, drawW, drawH, 0x0821);

  // 水平参考线（虚线）
  uint16_t gridColor = 0x2945;
  for (int i = 1; i < 4; i++) {
    int gy = drawY + drawH - (i * drawH / 4);
    for (int px = drawX; px < drawX + drawW; px += 4) {
      tft.drawPixel(px, gy, gridColor);
      tft.drawPixel(px + 1, gy, gridColor);
    }
  }

  int points = WAVE_POINTS;
  if (points > drawW) points = drawW;
  int validPoints = waveIdx;
  if (validPoints > points) validPoints = points;
  if (validPoints < 2) validPoints = 2;

  // 面积填充（由主题色暗调，向上渐变亮度）
  for (int i = 1; i < validPoints; i++) {
    int vp = constrain(buf[i-1], 0, 100);
    int vc = constrain(buf[i], 0, 100);
    if (vp == 0 && vc == 0) continue;
    int yp = drawY + drawH - (vp * drawH / 100);
    int yc = drawY + drawH - (vc * drawH / 100);
    int top = (yp < yc) ? yp : yc;
    if (top < drawY) top = drawY;
    if (top < drawY + drawH) {
      tft.drawLine(drawX + i, top, drawX + i, drawY + drawH, fillColor);
    }
  }

  // 波形线
  for (int i = 1; i < validPoints; i++) {
    int vp = constrain(buf[i-1], 0, 100);
    int vc = constrain(buf[i], 0, 100);
    int yp = drawY + drawH - (vp * drawH / 100);
    int yc = drawY + drawH - (vc * drawH / 100);
    if (yp < drawY) yp = drawY;
    if (yp > drawY + drawH) yp = drawY + drawH;
    if (yc < drawY) yc = drawY;
    if (yc > drawY + drawH) yc = drawY + drawH;
    tft.drawLine(drawX + i - 1, yp, drawX + i, yc, color);
  }

  // 当前值（右上角）
  int lastIdx = (waveIdx == 0) ? WAVE_POINTS - 1 : waveIdx - 1;
  int lastVal = constrain(buf[lastIdx], 0, 100);
  tft.setTextSize(1);
  tft.setTextColor(color);
  tft.fillRect(drawX + drawW - 34, drawY + 1, 32, 10, 0x0821);
  tft.drawString(String(lastVal) + "%", drawX + drawW - 32, drawY + 2);
  tft.setTextColor(C_VALUE);
}

void drawMainUI() {
  // ===== 蓝牙状态（标题栏右侧）=====
  static bool lastBle = false;
  if (firstRun || lastBle != bleConnected) {
    tft.fillRectVGradient(252, 2, 66, TITLE_H - 4, C_TITLE1, C_TITLE2);
    uint16_t dot = bleConnected ? C_OK : C_ALERT;
    tft.fillCircle(262, 12, 4, dot);
    tft.drawCircle(262, 12, 7, dot);
    tft.setTextSize(1);
    tft.setTextColor(C_VALUE);
    tft.drawString(bleConnected ? "ON" : "OFF", 276, 6);
    lastBle = bleConnected;
  }

  int vRightCpu = CPU_X + CARD_W - 8;
  int vRightGpu = GPU_X + CARD_W - 8;

  // ===== CPU =====
  if (firstRun || lastData.cpuLoad != dataPack.cpuLoad) {
    tft.fillRect(36, CARD_Y + 25, 116, 18, C_CARD);
    String s = String(dataPack.cpuLoad, 0) + "%";
    drawValue(vRightCpu, CARD_Y + 25, s, C_CPU);
    drawBar(CPU_X + 8, CARD_Y + 45, CARD_W - 16, 6, dataPack.cpuLoad);
  }
  if (firstRun || lastData.cpuTemp != dataPack.cpuTemp) {
    tft.fillRect(36, CARD_Y + 57, 116, 16, C_CARD);
    drawValue(vRightCpu, CARD_Y + 57, fmtValue(dataPack.cpuTemp, 1, "C"), C_VALUE);
  }
  if (firstRun || lastData.cpuPower != dataPack.cpuPower) {
    tft.fillRect(36, CARD_Y + 93, 116, 16, C_CARD);
    drawValue(vRightCpu, CARD_Y + 93, fmtValue(dataPack.cpuPower, 1, "W"), C_WARN);
  }
  drawWaveGraph(CPU_X, WAVE_Y, CARD_W, WAVE_H, cpuWave, lastCpuWave, C_CPU, C_CPU_DIM);

  // ===== GPU =====
  if (firstRun || lastData.gpuLoad != dataPack.gpuLoad) {
    tft.fillRect(196, CARD_Y + 25, 116, 18, C_CARD);
    String s = String(dataPack.gpuLoad, 0) + "%";
    drawValue(vRightGpu, CARD_Y + 25, s, C_GPU);
    drawBar(GPU_X + 8, CARD_Y + 45, CARD_W - 16, 6, dataPack.gpuLoad);
  }
  if (firstRun || lastData.gpuTemp != dataPack.gpuTemp) {
    tft.fillRect(196, CARD_Y + 57, 116, 16, C_CARD);
    drawValue(vRightGpu, CARD_Y + 57, fmtValue(dataPack.gpuTemp, 1, "C"), C_VALUE);
  }
  if (firstRun || lastData.gpuMem != dataPack.gpuMem ||
      lastData.gpuMemTotal != dataPack.gpuMemTotal) {
    tft.fillRect(196, CARD_Y + 75, 116, 16, C_CARD);
    drawValue(vRightGpu, CARD_Y + 75, fmtVram(dataPack.gpuMem, dataPack.gpuMemTotal), C_GPU);
  }
  if (firstRun || lastData.gpuPower != dataPack.gpuPower) {
    tft.fillRect(196, CARD_Y + 93, 116, 16, C_CARD);
    drawValue(vRightGpu, CARD_Y + 93, fmtValue(dataPack.gpuPower, 1, "W"), C_WARN);
  }
  drawWaveGraph(GPU_X, WAVE_Y, CARD_W, WAVE_H, gpuWave, lastGpuWave, C_GPU, C_GPU_DIM);

  // ===== 底部 =====
  if (firstRun || lastData.memUsed != dataPack.memUsed) {
    tft.fillRect(36, BOT_Y1, 120, 12, C_BG);
    tft.setTextColor(C_VALUE);
    tft.setTextSize(1);
    tft.drawString(String(dataPack.memUsed, 0) + "%", 44, BOT_Y1);
    drawBar(CPU_X + 8, BOT_Y1 + 10, CARD_W - 16, 6, dataPack.memUsed);
  }
  if (firstRun || lastData.hddTemp != dataPack.hddTemp) {
    tft.fillRect(36, BOT_Y2, 120, 12, C_BG);
    tft.setTextColor(C_ORANGE);
    tft.setTextSize(1);
    tft.drawString(fmtValue(dataPack.hddTemp, 1, "C"), 44, BOT_Y2);
  }
  if (firstRun || lastData.fps != dataPack.fps) {
    tft.fillRect(GPU_X + 28, BOT_Y2, 124, 12, C_BG);
    uint16_t fpsColor = (dataPack.fps > 120) ? C_OK : (dataPack.fps > 60) ? C_WARN : C_ALERT;
    tft.setTextColor(fpsColor);
    tft.setTextSize(1);
    tft.drawString(String(dataPack.fps, 0), GPU_X + 36, BOT_Y2);
  }

  if (firstRun) {
    firstRun = false;
  }
  lastData = dataPack;
}