#ifndef BLE_SERVICE_H
#define BLE_SERVICE_H

#include <Arduino.h>
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>
#include "config.h"

void bleInit();

// ---------------- 数据访问 ----------------
// BLE 回调跑在蓝牙任务里，主循环在另一个任务里绘制，
// 所以禁止直接读 dataPack（会读到"半新半旧"的一帧，波形还可能出尖刺）。
// 统一走下面这组 API：内部用临界区整体拷贝。
bool     bleDataSnapshot(HardwareData &out);              // 拷贝当前数据；从未收到过包时返回 false
bool     bleDataTake(HardwareData &out, uint32_t &seq);    // 有新包时返回 true，并更新 seq（用于推进波形）
uint32_t bleLastPacketMs(void);                           // 最近一次成功解析数据包的时间戳（millis）
uint32_t blePacketCount(void);                            // 累计成功解析的数据包数（界面诊断用）

#endif
