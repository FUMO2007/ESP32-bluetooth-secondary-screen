static bool lastTrendStale = false;
static uint16_t waveIdxForSample = 0xFFFF;
static uint32_t lastPushMs = 0;
static uint32_t sampleMsEma = 0;           // 实测采样间隔（波形每推进一个点的间隔）

// 告警标志（带 3 度回差，避免临界值反复闪）
