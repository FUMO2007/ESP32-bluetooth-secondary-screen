// ============================================================================
//  screen_draw.cpp —— 界面绘制（三页自动轮播：概览 / 详情 / 全屏波形）
// ----------------------------------------------------------------------------
//  四条约定：
//   1) 坐标全部来自下面"布局"一节，别处不写魔法数字；擦除矩形一律由这些常量
//      推导，并用 static_assert 在编译期挡住溢出。
//   2) 颜色分两套语义：品牌色 accent（CPU 绿 / GPU 橙）只做标识，
//      状态色 state（绿 / 黄 / 红）只表达告警，两者不混用。
//   3) 三页共用同一套卡片几何与行/格绘制函数，切页只是换内容，避免布局漂移。
//   4) 只有波形绘制区用离屏 sprite（内存画好一次推送，无闪烁）；其余按行增量刷新。
//
//  翻页规则（见 drawMainUI）：
//    · 每 PAGE_MS 换一页：概览 -> 详情 -> 全屏波形 -> 概览 …
//    · 任一告警出现时强制回到概览页并暂停轮播，告警解除后重新计时。
// ============================================================================
#include <Arduino.h>
#include "screen_draw.h"
#include "ble_service.h"

TFT_eSPI tft = TFT_eSPI();

// ===================== 主题色 =====================
#define C_BG         0x0000   // 背景
#define C_TITLE1     0x18E3   // 标题栏渐变（上）
#define C_TITLE2     0x0821   // 标题栏渐变（下）
#define C_PILL_BG    0x10A2   // 标题栏右侧链路胶囊底色
#define C_CARD       0x0C63   // 卡片背景
#define C_CARD_ED    0x2965   // 卡片描边 / 内部分隔线
#define C_LABEL      0xBDF7   // 行标签、单位
#define C_LABEL_DIM  0x7BCF   // 次要文字、刻度
#define C_VALUE      0xFFFF   // 数值
#define C_VALUE_DIM  0x8410   // 数据过期时的数值（置灰）
#define C_CPU        0x7FE0   // 品牌色：CPU
#define C_CPU_DIM    0x0460
#define C_GPU        0xFB00   // 品牌色：GPU
#define C_GPU_DIM    0x8800
#define C_CYAN       0x07FF   // 功率：既不是品牌色也不是告警色，单独一档
#define C_ORANGE     0xFD20
#define C_OK         0x07E0   // 状态色
#define C_WARN       0xFFE0
#define C_ALERT      0xF800
#define C_BAR_BG     0x0841   // 进度条底槽
#define C_PLOT_BG    0x0861   // 波形绘制区底
#define C_GRID       0x2945   // 波形参考线
#define C_DOT_OFF    0x4208   // 页码圆点（未选中）

// GLCD 字体（font 1）的表里第 0xF8 个字形就是度符号（Fonts/glcdfont.c）。
// 注意 TFT_eSPI 默认 _cp437=false 时会把 >0xAF 的字符整体错位一格（TFT_eSPI.cpp:3204），
// 所以 screenInit() 里要显式打开 CP437 开关，0xF8 才真的落在度符号上。
#define DEG "\xF8"

// ===================== 布局（320x240 横屏，唯一一处尺寸定义）=====================
#define SCR_W        320
#define SCR_H        240
#define PAD          4                       // 屏幕边距
#define GAP          4                       // 卡片之间的缝隙

#define TITLE_H      22                      // 标题栏

#define CARD_Y       (TITLE_H + GAP)         // 26
#define CARD_H       112
#define CARD_W       154
#define CPU_X        PAD                     // 4
#define GPU_X        (CPU_X + CARD_W + GAP)  // 162

#define CARD_PAD     8                       // 卡片内边距
#define RADIUS       8
#define LBL_W        26                      // 标签列宽（4 个 GLCD 字符 + 间隙）

// 卡片内部纵向偏移（相对卡片左上角）
#define TITLE_DY     3                       // 卡片标题
#define SEP_DY       19                      // 标题下的分隔线
#define HERO_DY      22                      // 主指标大字
#define HERO_H       26                      // Font4 行高
#define BAR_DY       49                      // 主指标进度条
#define BAR_H        6
#define ROW_DY(i)    (58 + (i) * 18)         // 三行次要指标：58 / 76 / 94
#define ROW_H        16                      // GLCD size2 行高

// 中块（概览页是波形卡片，详情页是系统卡片）——两页共用同一块位置
#define MID_Y        (CARD_Y + CARD_H + GAP) // 142
#define MID_H        62
#define MID_X        PAD
#define MID_W        (SCR_W - 2 * PAD)       // 312

// 概览页：双波形小图
#define WAVE_Y       MID_Y
#define WAVE_H       MID_H
#define WAVE_X       MID_X
#define WAVE_W       MID_W
#define GUTTER_W     22                      // 左侧刻度栏
#define PLOT_X       (WAVE_X + GUTTER_W)     // 26
#define PLOT_Y       (WAVE_Y + 16)           // 158
#define PLOT_W       (WAVE_W - GUTTER_W - PAD)  // 286：右边再留 4px，别盖住卡片右边框
#define PLOT_H       42

// 详情页：系统卡片（同一块位置）
#define SYS_CARD_Y   MID_Y                   // 142
#define SYS_CARD_H   MID_H                   // 62
#define SYS_HEAD_Y   (SYS_CARD_Y + 5)        // 147  SYSTEM / SAMPLE
#define SYS_ROW1_Y   (SYS_CARD_Y + 15)       // 157  RAM / DISK
#define SYS_BAR_Y    (SYS_CARD_Y + 34)       // 176  RAM 全宽进度条
#define SYS_ROW2_Y   (SYS_CARD_Y + 42)       // 184  UPTIME / PKTS
#define SYS_COL2_X   (GPU_X + CARD_PAD)      // 170  右列标签 x（与 GPU 卡片对齐）
#define SYS_VAL1_R   (CPU_X + CARD_W - CARD_PAD)   // 150
#define SYS_VAL2_R   (GPU_X + CARD_W - CARD_PAD)   // 307
#define SYS_BAR_X    (CPU_X + CARD_PAD)      // 12
#define SYS_BAR_W    (MID_W - 2 * CARD_PAD)  // 296
#define SYS_LBLW1    26                      // RAM / DISK 标签列宽
#define SYS_LBLW2    42                      // UPTIME 标签列宽（6 字符）

// 波形页：整页大图
#define TREND_CARD_Y CARD_Y                  // 26
#define TREND_CARD_H 178                     // 26..203（和中块底部对齐）
#define TREND_PLOT_X PLOT_X                  // 26
#define TREND_PLOT_Y (TREND_CARD_Y + 16)     // 42
#define TREND_PLOT_W PLOT_W                  // 286（和 sprite 等宽，走快路径推送）
#define TREND_PLOT_H 120                     // 42..161
#define TREND_DIV_Y  (TREND_CARD_Y + 142)    // 168 页脚分隔线
#define TREND_FOOT_Y (TREND_CARD_Y + 150)    // 176 峰值 / 采样率
#define TREND_FOOT_X (PAD + CARD_PAD)                    // 12 页脚三格起点
#define TREND_FOOT_W ((MID_W - 2 * CARD_PAD) / 3)        // 98 每格宽

// 底部状态条（三页共用位置，内容按页不同）
#define BOT_Y        (MID_Y + MID_H + GAP)   // 208
#define BOT_H        28
#define BOT_X        PAD
#define BOT_W        (SCR_W - 2 * PAD)
#define BOT_CELL     (BOT_W / 3)             // 104

// 标题栏：页码圆点
#define DOT_X        162
#define DOT_DX       16
#define DOT_Y        11

// 温度条的量程（详情页把温度做成主角，配一条温度计）
#define TEMP_BAR_MIN 30.0f
#define TEMP_BAR_MAX 100.0f
#define TEMP_WARN    75.0f                   // 到这个温度条变黄（真正的告警另有阈值）

// 编译期自检：任何一处尺寸改动越界，这里直接编译不过
static_assert(CARD_Y + CARD_H + GAP + MID_H + GAP + BOT_H + PAD <= SCR_H, "纵向布局超出屏幕");
static_assert(ROW_DY(2) + ROW_H <= CARD_H, "卡片行溢出卡片");
static_assert(HERO_DY + HERO_H <= BAR_DY, "主指标大字与进度条重叠");
static_assert(TITLE_DY + 16 <= SEP_DY, "卡片标题与分隔线重叠");
static_assert(PLOT_Y + PLOT_H <= WAVE_Y + WAVE_H - PAD, "概览波形绘制区溢出卡片");
static_assert(PLOT_X + PLOT_W + PAD <= WAVE_X + WAVE_W, "波形绘制区压到卡片右边框");
static_assert(TREND_PLOT_Y + TREND_PLOT_H <= TREND_DIV_Y, "波形页绘制区压到页脚");
static_assert(TREND_FOOT_Y + ROW_H <= TREND_CARD_Y + TREND_CARD_H - PAD, "波形页页脚溢出卡片");
static_assert(SYS_ROW2_Y + ROW_H <= SYS_CARD_Y + SYS_CARD_H - PAD, "系统卡片内容溢出");
static_assert(SYS_ROW1_Y + ROW_H <= SYS_BAR_Y, "系统卡片 RAM 行与进度条重叠");
static_assert(3 * TREND_FOOT_W + TREND_FOOT_X <= WAVE_X + WAVE_W - PAD, "波形页页脚超出卡片");
static_assert(GPU_X + CARD_W + PAD <= SCR_W, "右侧卡片超出屏幕");
static_assert(DOT_X + 2 * DOT_DX + 4 < 250, "页码圆点撞到链路胶囊");

