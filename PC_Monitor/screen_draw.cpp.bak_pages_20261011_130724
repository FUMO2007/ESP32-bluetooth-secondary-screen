// 底部状态条的三个标签
static void drawStripLabels(const char *const *labels) {
  for (int i = 0; i < 3; i++) {
    tft.setTextFont(1);
    tft.setTextSize(1);
    tft.setTextDatum(TL_DATUM);
    tft.setTextColor(C_LABEL);
    tft.drawString(labels[i], BOT_X + i * BOT_CELL + 6, BOT_Y + (BOT_H - ROW_H) / 2 + 4);
  }
