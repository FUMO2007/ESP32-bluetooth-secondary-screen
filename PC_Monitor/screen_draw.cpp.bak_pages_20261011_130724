// 概览页波形卡右上角的峰值读数
// 注意：这里画的字符串长度会变（"PEAK 92% / 88%" <-> "PEAK --"），
// 而 drawString 只画字形、不擦底，所以必须先把整块区域擦干净，否则会叠字。
#define PEAK_W 104                            // "PEAK 100% / 100%" 是最宽的情形
static void drawPeaks(bool stale) {
  const int xr = WAVE_X + WAVE_W - CARD_PAD;

  tft.setTextFont(1);
  tft.setTextSize(1);
  tft.setTextDatum(TL_DATUM);
  tft.fillRect(xr - PEAK_W, WAVE_Y + 3, PEAK_W, 11, C_CARD);
  tft.setTextDatum(TR_DATUM);

  int pc = 0, pg = 0;
  if (stale || !computePeaks(pc, pg)) {
    tft.setTextColor(C_LABEL_DIM);
    tft.drawString("PEAK --", xr, WAVE_Y + 4);
    return;
  }

  String cs = String(pc) + "%";
  String gs = String(pg) + "%";
  int wc = tft.textWidth(cs, 1);
  int wg = tft.textWidth(gs, 1);
  int ws = tft.textWidth("/", 1);

  int x1 = xr;                     // GPU 峰值
  int x2 = x1 - wg - 2;            // 斜杠
  int x3 = x2 - ws - 2;            // CPU 峰值
  int x4 = x3 - wc - 6;            // "PEAK"

  tft.setTextColor(C_LABEL_DIM);
  tft.drawString("PEAK", x4, WAVE_Y + 4);
  tft.setTextColor(C_CPU);
  tft.drawString(cs, x3, WAVE_Y + 4);
  tft.setTextColor(C_LABEL_DIM);
  tft.drawString("/", x2, WAVE_Y + 4);
  tft.setTextColor(C_GPU);
  tft.drawString(gs, x1, WAVE_Y + 4);
}

// 卡片主指标：Font4 大字 + 小号单位 + 进度条（pct 与 barCol 由调用者给）
static void drawHero(int x, const char *label, const String &main, const char *unit,
                     uint16_t color, float pct, uint16_t barCol) {
  const int xl    = x + CARD_PAD;
  const int xr    = x + CARD_W - CARD_PAD;
  const int slotW = CARD_W - 2 * CARD_PAD;
  const int y     = CARD_Y + HERO_DY;

  // 擦除主指标区（含进度条）；行标签在同一块里，所以每次都重画
  tft.fillRect(xl, y, slotW, (BAR_DY + BAR_H) - HERO_DY, C_CARD);

  tft.setTextFont(1);
  tft.setTextSize(1);
  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(C_LABEL);
  tft.drawString(label, xl, y + 10);

  int uw  = tft.textWidth(String(unit), 1);
  int gap = (main == "--") ? 0 : 2;
  if (main == "--") uw = 0;

  tft.setTextFont(4);                       // 26px 高，作为视觉主角
  tft.setTextSize(1);
  tft.setTextDatum(TR_DATUM);
  tft.setTextColor(color);
  tft.drawString(main, xr - uw - gap, y);

  if (uw) {
    tft.setTextFont(1);
    tft.setTextSize(1);
    tft.setTextColor(C_LABEL);
    tft.drawString(unit, xr, y + HERO_H - 8);   // 单位底边与大字对齐
  }

  tft.setTextFont(1);                          // 别把 Font4 留给后面的绘制
  tft.setTextSize(1);

  drawBar(xl, CARD_Y + BAR_DY, slotW, BAR_H, (main == "--") ? 0 : pct, barCol);
}

// 卡片次要指标行：标签是静态的（页面静态函数画），这里只刷数值区
static void drawRow(int x, int row, const String &main, const char *unit, uint16_t color) {
  drawRowAt(x + CARD_PAD, LBL_W, x + CARD_W - CARD_PAD, CARD_Y + ROW_DY(row), main, unit, color);
}

