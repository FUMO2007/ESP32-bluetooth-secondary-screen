// 底部状态条的外框
static void drawStripFrame() {
  tft.fillRoundRect(BOT_X, BOT_Y, BOT_W, BOT_H, RADIUS, C_CARD);
  tft.drawRoundRect(BOT_X, BOT_Y, BOT_W, BOT_H, RADIUS, C_CARD_ED);
  tft.drawFastVLine(BOT_X + BOT_CELL,     BOT_Y + 7, BOT_H - 14, C_CARD_ED);
  tft.drawFastVLine(BOT_X + 2 * BOT_CELL, BOT_Y + 7, BOT_H - 14, C_CARD_ED);
}

// 状态条里的一格
static void drawCell(int i, const String &main, const char *unit, uint16_t color) {
  const int x0 = BOT_X + i * BOT_CELL;
  const int y  = BOT_Y + (BOT_H - ROW_H) / 2;
  const int slotW = BOT_CELL - 30 - CARD_PAD;

  tft.fillRect(x0 + 30, y, slotW, ROW_H, C_CARD);
  drawValueRight(x0 + BOT_CELL - CARD_PAD, y, main, unit, color, slotW);
}

// 底栏三格：CPU / GPU / FPS（详情页和波形页共用）
static void drawLoadStrip(const FrameCtx &c) {
  if (c.full || lastData.cpuLoad != c.d.cpuLoad || (c.aCpuL && c.blinkFlip)) {
    uint16_t col = c.stale ? C_VALUE_DIM : (c.aCpuL && c.blinkOn ? C_ALERT : C_CPU);
    drawCell(0, fPct(c.d.cpuLoad, c.hasData), "%", col);
  }
  if (c.full || lastData.gpuLoad != c.d.gpuLoad || (c.aGpuL && c.blinkFlip)) {
    uint16_t col = c.stale ? C_VALUE_DIM : (c.aGpuL && c.blinkOn ? C_ALERT : C_GPU);
    drawCell(1, fPct(c.d.gpuLoad, c.hasData), "%", col);
  }
  if (c.full || lastData.fps != c.d.fps) {
    drawCell(2, fFps(c.d.fps, c.hasData), "", fpsColor(c.d.fps, c.hasData, c.stale));
  }
}

// ===================== 波形 =====================
// 环形缓冲按"时间序"取点：i=0 是最旧的可见样本，i=n-1 是最新样本。
// 旧代码直接把 buf[0..waveIdx-1] 当成从左到右的历史，waveIdx 一回绕（写满 140 点）
// 波形就会塌成 2 个点、再从左边重新长出来，而且顺序也是错的。
static int waveIndexAt(int i, int n) {
  int idx = (int)waveIdx - n + i;
  if (idx < 0) idx += WAVE_POINTS;
  return idx % WAVE_POINTS;
}

// 当前窗口内的峰值（返回是否有数据）
static bool computePeaks(int &pc, int &pg) {
  int n = (waveCount > WAVE_POINTS) ? WAVE_POINTS : waveCount;
  if (n < 2) return false;
  pc = 0; pg = 0;
  for (int i = 0; i < n; i++) {
    int idx = waveIndexAt(i, n);
    if (cpuWave[idx] > pc) pc = cpuWave[idx];
    if (gpuWave[idx] > pg) pg = gpuWave[idx];
  }
  return true;
}

// 在 g 上画波形（g 既可以是离屏 sprite，也可以是屏幕本身；ox/oy/w/h 决定画布）
static void plotTrend(TFT_eSPI &g, int ox, int oy, int w, int h, bool stale) {
  g.fillRect(ox, oy, w, h, C_PLOT_BG);

  // 25 / 50 / 75 参考线（虚线）
  for (int i = 1; i <= 3; i++) {
    int gy = oy + h - 1 - (i * (h - 1) / 4);
    for (int x = 0; x < w; x += 4) {
      g.drawPixel(ox + x, gy, C_GRID);
      g.drawPixel(ox + x + 1, gy, C_GRID);
    }
  }

  if (stale) {
    g.setTextFont(1);
    g.setTextSize(1);
    g.setTextDatum(TL_DATUM);
    g.setTextColor(C_ALERT);
    g.drawString("NO SIGNAL", ox + (w - 54) / 2, oy + h / 2 - 4);
    return;
  }

  int n = (waveCount > WAVE_POINTS) ? WAVE_POINTS : waveCount;
  if (n < 2) return;

  int prevX = 0, prevYc = 0, prevYg = 0;
  for (int i = 0; i < n; i++) {
    int idx = waveIndexAt(i, n);
    int x   = ox + w - 1 - (n - 1 - i) * w / WAVE_POINTS;
    int yc  = oy + h - 1 - constrain(cpuWave[idx], 0, 100) * (h - 1) / 100;
    int yg  = oy + h - 1 - constrain(gpuWave[idx], 0, 100) * (h - 1) / 100;

    if (i) {                                   // 线画两像素，240p 上更清楚
      g.drawLine(prevX, prevYc, x, yc, C_CPU);
      g.drawLine(prevX, prevYc + 1, x, yc + 1, C_CPU);
      g.drawLine(prevX, prevYg, x, yg, C_GPU);
      g.drawLine(prevX, prevYg + 1, x, yg + 1, C_GPU);
    }
    prevX = x; prevYc = yc; prevYg = yg;
  }

  // 最新点的小圆点，让"活在当下"这件事一眼可见
  g.fillCircle(ox + w - 1, prevYc, 2, C_CPU);
  g.fillCircle(ox + w - 1, prevYg, 2, C_GPU);
}

// 把 sprite 里的波形推到屏幕指定位置（w x h 是本次要推的子矩形）
static void pushTrend(int x, int y, int w, int h, bool stale) {
  if (trendSpr.created()) {
    plotTrend(trendSpr, 0, 0, w, h, stale);
    trendSpr.pushSprite(x, y, 0, 0, w, h);       // 一次推送，无闪烁
  } else {
    plotTrend(tft, x, y, w, h, stale);           // 兜底：sprite 分配失败就直接画
  }
}

