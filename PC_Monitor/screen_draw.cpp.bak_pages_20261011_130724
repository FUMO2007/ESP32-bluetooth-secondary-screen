// 波形离屏缓冲：按最大的那块画布分配（波形页），概览页只推送其中 42 行
static TFT_eSprite trendSpr = TFT_eSprite(&tft);

// 一帧内的公共状态，避免每个页面函数一长串参数
struct FrameCtx {
  HardwareData d;
  uint32_t now;
  bool hasData;
  bool stale;
  bool full;          // 本帧需要整体重画（首帧 / 切页 / 链路状态翻转）
  bool blinkOn;
  bool blinkFlip;
  bool aCpuT, aGpuT, aCpuL, aGpuL, aMem;
  uint16_t cPwr, cClk, cVram;
