  drawValueRight(x0 + TREND_FOOT_W - CARD_PAD, TREND_FOOT_Y, main, unit, color, slotW);
}

static void pageTrend(const FrameCtx &c) {
  // ---- 大波形 ----
  if (c.full || waveIdx != lastSeenWaveIdx || c.stale != lastTrendStale) {
    pushTrend(TREND_PLOT_X, TREND_PLOT_Y, TREND_PLOT_W, TREND_PLOT_H, c.stale);

    int pc = 0, pg = 0;
    bool has = (!c.stale) && computePeaks(pc, pg);
    drawFootCell(0, has ? String(pc) + "%" : "--", "", has ? C_CPU : C_LABEL_DIM);
    drawFootCell(1, has ? String(pg) + "%" : "--", "", has ? C_GPU : C_LABEL_DIM);
    drawFootCell(2, fRate(), "", c.stale ? C_VALUE_DIM : C_LABEL);

    // 右上角窗口时长（字符串长度会变，先擦再画）
    tft.setTextFont(1);
    tft.setTextSize(1);
    tft.setTextDatum(TL_DATUM);
    tft.fillRect(TREND_PLOT_X + TREND_PLOT_W - 104, TREND_CARD_Y + 3, 104, 11, C_CARD);
    tft.setTextDatum(TR_DATUM);
    tft.setTextColor(C_LABEL_DIM);
    tft.drawString("WINDOW", TREND_PLOT_X + TREND_PLOT_W - 48, TREND_CARD_Y + 4);
    tft.setTextColor(C_LABEL);
    tft.drawString(fWindow(), TREND_PLOT_X + TREND_PLOT_W, TREND_CARD_Y + 4);

    lastSeenWaveIdx = waveIdx;
    lastTrendStale = c.stale;
  }

  drawLoadStrip(c);
}

// ===================== 主刷新 =====================
static void drawPageStatic(uint8_t page) {
  switch (page) {
    case P_DETAIL: drawStaticDetail(); break;
    case P_TREND:  drawStaticTrend();  break;
    default:       drawStaticOverview(); break;
  }
}

void drawStaticUI() {
  drawStaticOverview();
}

void drawMainUI() {
  FrameCtx c;
  c.hasData = bleDataSnapshot(c.d);
  c.now = millis();
  c.stale = (!c.hasData) || ((uint32_t)(c.now - bleLastPacketMs()) > DATA_TIMEOUT_MS);

  // 告警（带回差）
  c.aCpuT = alarmUpdate(alarmCpuTemp, c.d.cpuTemp,  ALARM_CPU_TEMP);
  c.aGpuT = alarmUpdate(alarmGpuTemp, c.d.gpuTemp,  ALARM_GPU_TEMP);
  c.aCpuL = alarmUpdate(alarmCpuLoad, c.d.cpuLoad,  ALARM_CPU_LOAD);
  c.aGpuL = alarmUpdate(alarmGpuLoad, c.d.gpuLoad,  ALARM_GPU_LOAD);
  c.aMem  = alarmUpdate(alarmMem,     c.d.memUsed,  ALARM_MEM);

  // 闪烁用 millis 计时，不再依赖 loop 的实际帧率
  c.blinkOn = ((c.now / BLINK_MS) & 1) == 0;
  static bool lastBlinkOn = true;
  c.blinkFlip = (c.blinkOn != lastBlinkOn);
  lastBlinkOn = c.blinkOn;

  // 过期时统一置灰
  c.cPwr  = c.stale ? C_VALUE_DIM : C_CYAN;
  c.cClk  = c.stale ? C_VALUE_DIM : C_LABEL;
  c.cVram = c.stale ? C_VALUE_DIM : C_GPU;

  // ---- 采样统计：波形每推进一个点算一次间隔 ----
  // （比用发包率准：主循环 200ms 会把更快的包合并掉，趋势图的真实时间轴按这个算）
  if (waveIdx != waveIdxForSample) {
    if (lastPushMs != 0) {
      uint32_t dt = c.now - lastPushMs;
      if (dt > 0 && dt < 60000UL) sampleMsEma = sampleMsEma ? (sampleMsEma * 3 + dt) / 4 : dt;
    }
    lastPushMs = c.now;
    waveIdxForSample = waveIdx;
  }

  // ---- 翻页：有告警就锁在概览页 ----
  bool anyAlarm = c.aCpuT || c.aGpuT || c.aCpuL || c.aGpuL || c.aMem;
  bool pageSwitched = false;
  if (firstRun) {
    pageStartMs = c.now;
  } else if (anyAlarm) {
    if (curPage != P_OVERVIEW) { curPage = P_OVERVIEW; pageSwitched = true; }
    pageStartMs = c.now;
  } else if ((uint32_t)(c.now - pageStartMs) >= PAGE_MS) {
    curPage = (uint8_t)((curPage + 1) % PAGE_COUNT);
    pageStartMs = c.now;
    pageSwitched = true;
  }

  c.full = firstRun || pageSwitched || (c.stale != lastStale);

  // 切页 / 首帧：整页重画；否则只在链路状态变化时补画标题栏
  if (c.full) {
    drawPageStatic(curPage);
  } else if (lastBle != bleConnected) {
    drawTitleBar(PAGE_NAME[curPage], curPage);
    drawBlePill();
  }
  lastBle = bleConnected;

  switch (curPage) {
    case P_DETAIL: pageDetail(c); break;
    case P_TREND:  pageTrend(c);  break;
    default:       pageOverview(c); break;
  }

  firstRun = false;
  lastStale = c.stale;
  lastTickSec = c.now / 1000;
  lastData = c.d;
}

// ===================== 初始化 =====================
void screenInit() {
  tft.init();
  tft.setRotation(1);
  // 打开 GLCD 字体的 CP437 修正，否则度符号(0xF8)会错位一格画成别的字形
  tft.setAttribute(CP437_SWITCH, 1);
  tft.fillScreen(C_BG);
  tft.setTextColor(C_VALUE, C_BG);
  tft.setTextDatum(TL_DATUM);

  // 背光引脚 TFT_BL 由 tft_setup.h 统一定义（12）。
  // TFT_eSPI::init() 已按 TFT_BACKLIGHT_ON 拉高，这里再显式确认一次。
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  memset(&lastData, 0, sizeof(HardwareData));
  firstRun = true;
  lastStale = false;
  lastBle = false;
  curPage = P_OVERVIEW;
  pageStartMs = millis();
  lastTickSec = 0;
  lastSeenWaveIdx = 0xFFFF;
  lastTrendStale = false;
  waveIdxForSample = 0xFFFF;
  lastPushMs = 0;
  sampleMsEma = 0;
  alarmCpuTemp = alarmGpuTemp = alarmCpuLoad = alarmGpuLoad = alarmMem = false;

  // 离屏缓冲按最大的画布分配（波形页 286x120x2 = 68KB），概览页只推其中 42 行
  trendSpr.setColorDepth(16);
  trendSpr.createSprite(PLOT_W, TREND_PLOT_H);
  if (!trendSpr.created()) {
    Serial.println("[UI] trend sprite alloc failed -> direct draw fallback");
  } else {
    Serial.printf("[UI] trend sprite %dx%d ok, free heap %u\n",
                  (int)PLOT_W, (int)TREND_PLOT_H, (unsigned)ESP.getFreeHeap());
  }

  drawStaticUI();
}
