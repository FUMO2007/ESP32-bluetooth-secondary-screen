// ===================== 小工具 =====================
// 读数文本：没收到过数据、或读数无效（<=0 视为传感器读不到）-> "--"
static String fNum(float v, int dec, bool hasData) {
  if (!hasData || v <= 0) return "--";
  return String(v, dec);
}

// 百分比类读数：0 是合法值
static String fPct(float v, bool hasData) {
  if (!hasData) return "--";
  return String(v, 0);
}

// 显存：已用/总量（单位 GB），读不到显示 --
static String fVram(float used, float total, bool hasData) {
  if (!hasData || used < 0 || total <= 0) return "--";
  return String(used, 1) + "/" + String(total, 0);
}

// FPS：桌面/没跑游戏时是 0，不该当成告警
static String fFps(float fps, bool hasData) {
  if (!hasData || fps <= 0) return "--";
  return String(fps, 0);
}

// 运行时长：12m34s / 1h02m / 3d04h
static String fUptime(uint32_t ms) {
  uint32_t s = ms / 1000;
  char b[16];
  if (s < 3600)        snprintf(b, sizeof(b), "%lum%02lus", (unsigned long)(s / 60), (unsigned long)(s % 60));
  else if (s < 86400)  snprintf(b, sizeof(b), "%luh%02lum", (unsigned long)(s / 3600), (unsigned long)((s % 3600) / 60));
  else                 snprintf(b, sizeof(b), "%lud%02luh", (unsigned long)(s / 86400), (unsigned long)((s % 86400) / 3600));
  return String(b);
}

// 包计数：超过 1 万用 k 缩写，避免占满格
static String fPkts(uint32_t n) {
  if (n >= 10000UL) return String(n / 1000.0f, 1) + "k";
  return String(n);
}

// 实测采样率（波形每点间隔的倒数）
static String fRate() {
  if (!sampleMsEma) return "--";
  return String(1000.0f / sampleMsEma, 1) + "Hz";
}

// 波形窗口时长 = 点数 x 采样间隔
static String fWindow() {
  if (!sampleMsEma || waveCount < 2) return "--";
  uint32_t s = (uint32_t)waveCount * sampleMsEma / 1000;
  if (s < 60) return String(s) + "s";
  char b[16];
  snprintf(b, sizeof(b), "%lum%02lus", (unsigned long)(s / 60), (unsigned long)(s % 60));
  return String(b);
}

static uint16_t fpsColor(float fps, bool hasData, bool stale) {
  if (stale || !hasData || fps <= 0) return C_VALUE_DIM;
  if (fps >= 60) return C_OK;
  if (fps >= 30) return C_WARN;
  return C_ALERT;
}

// 进度条 / 底栏分档：常态用品牌色，超过阈值才切状态色
static uint16_t stateColor(float pct, uint16_t accent) {
  if (pct >= BAR_CRIT_PCT) return C_ALERT;
  if (pct >= BAR_WARN_PCT) return C_WARN;
  return accent;
}

// 温度 -> 进度条百分比（30..100 度映射到 0..100%）
static float tempPct(float t) {
  float p = (t - TEMP_BAR_MIN) * 100.0f / (TEMP_BAR_MAX - TEMP_BAR_MIN);
  return constrain(p, 0.0f, 100.0f);
}

// 带回差的告警判定：到 on 值触发，掉到 on-ALARM_HYS 以下才解除
static bool alarmUpdate(bool &flag, float v, float on) {
  if (!flag) {
    if (v >= on) flag = true;
  } else if (v <= on - ALARM_HYS) {
    flag = false;
  }
  return flag;
}

// 在卡片里右对齐画数值 + 小号单位；放不下就整行降为小号（绝不越过标签列）
static void drawValueRight(int xRight, int y, const String &main, const char *unit,
                           uint16_t color, int slotW) {
  bool hasUnit = (unit != nullptr && unit[0] != '\0');
  if (main == "--") hasUnit = false;          // 没读数就别再挂单位

  tft.setTextFont(1);
  tft.setTextSize(1);
  int uw  = hasUnit ? tft.textWidth(String(unit), 1) : 0;
  int gap = hasUnit ? 2 : 0;

  tft.setTextSize(2);
  bool fits = (tft.textWidth(main, 1) + uw + gap) <= slotW;   // textWidth 已含 textsize 缩放
  if (!fits) tft.setTextSize(1);

  int my = fits ? y : y + 4;                  // 小号时在 16px 行里垂直居中
  tft.setTextDatum(TR_DATUM);
  tft.setTextColor(color);
  tft.drawString(main, xRight - uw - gap, my);

  if (hasUnit) {
    tft.setTextSize(1);
    tft.setTextColor(C_LABEL);
    tft.drawString(unit, xRight, my + (fits ? 8 : 0));   // 与数值底边对齐
  }
}

// 进度条：底槽 + 差值填充（圆头）
static void drawBar(int x, int y, int w, int h, float pct, uint16_t color) {
  float p = constrain(pct, 0.0f, 100.0f);
  int len = (int)(p * w / 100.0f + 0.5f);

  tft.fillRoundRect(x, y, w, h, h / 2, C_BAR_BG);
  if (len <= 1) return;
  if (len >= h) tft.fillRoundRect(x, y, len, h, h / 2, color);
  else          tft.fillRect(x, y, len, h, color);
}

// 选项卡里的一行：左侧标签 + 右侧数值（先擦数值区，再画）
static void drawRowAt(int labelX, int labelW, int valRight, int y,
                      const String &main, const char *unit, uint16_t color) {
  int slotW = valRight - (labelX + labelW);
  tft.fillRect(labelX + labelW, y, slotW, ROW_H, C_CARD);
  drawValueRight(valRight, y, main, unit, color, slotW);
}

// ===================== 静态界面构件 =====================
static void drawTitleBar(const char *pageName, int page) {
  tft.fillRectVGradient(0, 0, SCR_W, TITLE_H, C_TITLE1, C_TITLE2);
  tft.setTextFont(2);
  tft.setTextSize(1);
  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(C_VALUE);
  tft.drawString("PC MONITOR", 8, 3);

  tft.setTextFont(1);
  tft.setTextSize(1);
  tft.setTextColor(C_LABEL_DIM);
  tft.drawString(pageName, 96, 7);

  // 页码圆点：当前页实心白点，其余空心暗点
  for (int i = 0; i < PAGE_COUNT; i++) {
    int x = DOT_X + i * DOT_DX;
    if (i == page) {
      tft.fillCircle(x, DOT_Y, 3, C_VALUE);
      tft.drawCircle(x, DOT_Y, 3, C_LABEL);
    } else {
      tft.drawCircle(x, DOT_Y, 3, C_DOT_OFF);
    }
  }

  tft.drawFastHLine(0, TITLE_H - 1, SCR_W, 0x1CAF);
}

// 链路状态胶囊：整条标题栏重画后再画胶囊。
// （旧写法只补画胶囊那一小块，用的是"20 行"的渐变去覆盖"24 行"的渐变，接缝肉眼可见）
static void drawBlePill() {
  const int px = 250, py = 3, pw = SCR_W - px - PAD, ph = TITLE_H - 6;
  uint16_t col = bleConnected ? C_OK : C_ALERT;

  tft.fillRoundRect(px, py, pw, ph, ph / 2, C_PILL_BG);
