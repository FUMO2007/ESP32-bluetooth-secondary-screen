#include "ble_service.h"

BLEServer *bleServer = nullptr;
BLECharacteristic *writeChar = nullptr;
BLECharacteristic *notifyChar = nullptr;

class ServerCallback : public BLEServerCallbacks {
  void onConnect(BLEServer* server) {
    bleConnected = true;
    Serial.println("BLE Device Connected");
  }
  
  void onDisconnect(BLEServer* server) {
    bleConnected = false;
    bleServer->startAdvertising();
    Serial.println("BLE Device Disconnected");
  }
};

class CharCallback : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *ch) {
    String rawData = ch->getValue();
    
    if (rawData.length() == 0) {
      Serial.println("Empty data received");
      return;
    }
    
    // 解析12个字段
    int parsed = sscanf(rawData.c_str(),
      "%f,%f,%f,%f,%f,%f,%f,%f,%f,%f,%f,%f",
      &dataPack.cpuLoad, &dataPack.cpuTemp, &dataPack.cpuFan, &dataPack.cpuPower,
      &dataPack.gpuLoad, &dataPack.gpuTemp, &dataPack.gpuMem,
      &dataPack.gpuFan, &dataPack.gpuPower, &dataPack.fps,
      &dataPack.memUsed, &dataPack.hddTemp);
    
    if (parsed == 12) {
      dataPack.cpuLoad = constrain(dataPack.cpuLoad, 0, 100);
      dataPack.gpuLoad = constrain(dataPack.gpuLoad, 0, 100);
      dataPack.fps = constrain(dataPack.fps, 0, 1000);
      dataPack.memUsed = constrain(dataPack.memUsed, 0, 100);
      
      cpuWave[waveIdx] = (int)dataPack.cpuLoad;
      gpuWave[waveIdx] = (int)dataPack.gpuLoad;
      waveIdx = (waveIdx + 1) % WAVE_POINTS;
      
      // 调试输出（按需开启）
      // Serial.printf("CPU: %.1f%%, %.1fW | GPU: %.1f%%, %.1fW\n", 
      //               dataPack.cpuLoad, dataPack.cpuPower, 
      //               dataPack.gpuLoad, dataPack.gpuPower);
    } else {
      Serial.printf("Parse error: expected 12, got %d\n", parsed);
      Serial.println("Raw: " + rawData);
    }
  }
};

void bleInit() {
  BLEDevice::init(BLE_DEVICE_NAME);
  
  #ifdef BLE_MTU_SIZE
  BLEDevice::setMTU(BLE_MTU_SIZE);
  Serial.printf("BLE MTU set to %d\n", BLE_MTU_SIZE);
  #endif
  
  bleServer = BLEDevice::createServer();
  bleServer->setCallbacks(new ServerCallback());

  BLEService *service = bleServer->createService(SERVICE_UUID);
  
  writeChar = service->createCharacteristic(
    CHAR_WRITE_UUID,
    BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR
  );
  writeChar->setCallbacks(new CharCallback());
  
  // 通知特征
  notifyChar = service->createCharacteristic(
    "beb5483e-36e1-4688-b7f5-ea07361b26a9",
    BLECharacteristic::PROPERTY_NOTIFY
  );
  notifyChar->addDescriptor(new BLE2902());
  
  service->start();

  BLEAdvertising *adv = BLEDevice::getAdvertising();
  adv->addServiceUUID(SERVICE_UUID);
  adv->setScanResponse(true);
  adv->setAppearance(0x00);
  adv->setMinInterval(0x20);
  adv->setMaxInterval(0x40);
  adv->setName(BLE_DEVICE_NAME);
  
  adv->start();
  Serial.println("BLE Advertising started");
}