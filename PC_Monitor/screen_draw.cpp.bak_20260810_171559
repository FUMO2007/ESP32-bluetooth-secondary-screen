#include "screen_draw.h"

TFT_eSPI tft = TFT_eSPI();

static HardwareData lastData;
static bool firstRun = true;
static int lastCpuWave[WAVE_POINTS] = {0};
static int lastGpuWave[WAVE_POINTS] = {0};

void screenInit() {
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);
  
  memset(&lastData, 0, sizeof(HardwareData));
  memset(lastCpuWave, -1, sizeof(lastCpuWave));
  memset(lastGpuWave, -1, sizeof(lastGpuWave));
  
  drawStaticUI();
}

void drawStaticUI() {
  tft.fillScreen(TFT_BLACK);
  
  // ===== 标题栏 =====
  tft.fillRect(0, 0, 320, 26, 0x1082);
  tft.setTextSize(2);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("PC Monitor", 10, 4);
  
  // ===== 蓝牙状态（标题栏右侧） =====
  uint16_t dotColor = bleConnected ? TFT_GREEN : TFT_RED;
  tft.fillCircle(270, 14, 4, dotColor);
  for (int r = 5; r < 8; r++) {
    tft.drawCircle(270, 14, r, dotColor);
  }
  tft.setTextSize(1);
  tft.setTextColor(TFT_WHITE);
  tft.drawString(bleConnected ? "ON" : "OFF", 280, 9);
  
  tft.drawLine(0, 26, 320, 26, 0x7BEF);
  
  tft.setTextSize(1);
  tft.setTextColor(TFT_WHITE);
  
  // ===== 坐标定义 =====
  int col1X = 5;
  int col2X = 165;
  int startY = 32;
  int lineH = 18;
  int waveY = startY + lineH * 4 + 4;
  int waveW = 150;
  int waveH = 56;
  
  // ===== 左列：CPU =====
  tft.setTextColor(TFT_GREEN);
  tft.drawString("CPU", col1X + 2, startY);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Load:", col1X + 2, startY + lineH);
  tft.drawString("Fan:", col1X + 2, startY + lineH * 2);
  tft.drawString("Pwr:", col1X + 2, startY + lineH * 3);
  
  // ===== 右列：GPU =====
  tft.setTextColor(TFT_RED);
  tft.drawString("GPU", col2X + 2, startY);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Load:", col2X + 2, startY + lineH);
  tft.drawString("VRAM:", col2X + 2, startY + lineH * 2);
  tft.drawString("Pwr:", col2X + 2, startY + lineH * 3);
  
  // ===== 波形框 =====
  tft.drawRect(col1X, waveY, waveW, waveH, 0x7BEF);
  tft.fillRect(col1X + 1, waveY + 1, waveW - 2, waveH - 2, 0x18C3);
  
  tft.drawRect(col2X, waveY, waveW, waveH, 0x7BEF);
  tft.fillRect(col2X + 1, waveY + 1, waveW - 2, waveH - 2, 0x18C3);
  
  // ===== 底部信息 =====
  int bottomY = waveY + waveH + 14;
  tft.drawString("RAM:", col1X + 2, bottomY);
  tft.drawString("Disk:", col1X + 2, bottomY + lineH);
  tft.drawString("FPS:", col2X + 2, bottomY);
  
  tft.drawLine(160, 28, 160, bottomY + lineH + 5, 0x39E7);
}

void drawWaveGraph(uint16_t x, uint16_t y, uint16_t w, uint16_t h, 
                    int buf[], int lastBuf[], uint16_t color) {
  int drawX = x + 2;
  int drawY = y + 2;
  int drawW = w - 4;
  int drawH = h - 4;
  
  tft.fillRect(drawX, drawY, drawW, drawH, 0x18C3);
  
  // ===== 水平参考线（虚线，更美观） =====
  uint16_t gridColor = 0x2945;  // 深灰色，不显眼
  for (int i = 1; i < 4; i++) {
    int gy = drawY + drawH - (i * drawH / 4);
    // 虚线效果：画2像素跳2像素
    for (int px = drawX; px < drawX + drawW; px += 4) {
      tft.drawPixel(px, gy, gridColor);
      tft.drawPixel(px + 1, gy, gridColor);
    }
  }
  
  int points = WAVE_POINTS;
  if (points > drawW) points = drawW;
  
  int validPoints = waveIdx;
  if (validPoints > points) validPoints = points;
  if (validPoints < 2) validPoints = 2;
  
  // ===== 填充 =====
  for (int i = 1; i < validPoints; i++) {
    int val_prev = constrain(buf[i-1], 0, 100);
    int val_curr = constrain(buf[i], 0, 100);
    if (val_prev == 0 && val_curr == 0) continue;
    
    int y_prev = drawY + drawH - (val_prev * drawH / 100);
    int y_curr = drawY + drawH - (val_curr * drawH / 100);
    int fillStart = (y_prev < y_curr) ? y_prev : y_curr;
    int fillEnd = drawY + drawH;
    
    if (fillStart < drawY) fillStart = drawY;
    if (fillStart > drawY + drawH) fillStart = drawY + drawH;
    
    uint16_t fillColor = (color == TFT_GREEN) ? 0x03A0 : 0x7800;
    if (fillStart < fillEnd) {
      tft.drawLine(drawX + i, fillStart, drawX + i, fillEnd, fillColor);
    }
  }
  
  // ===== 波形线 =====
  for (int i = 1; i < validPoints; i++) {
    int val_prev = constrain(buf[i-1], 0, 100);
    int val_curr = constrain(buf[i], 0, 100);
    
    int y_prev = drawY + drawH - (val_prev * drawH / 100);
    int y_curr = drawY + drawH - (val_curr * drawH / 100);
    
    if (y_prev < drawY) y_prev = drawY;
    if (y_prev > drawY + drawH) y_prev = drawY + drawH;
    if (y_curr < drawY) y_curr = drawY;
    if (y_curr > drawY + drawH) y_curr = drawY + drawH;
    
    tft.drawLine(drawX + i - 1, y_prev, drawX + i, y_curr, color);
  }
  
  // ===== 百分比值 =====
  int lastIdx = (waveIdx == 0) ? WAVE_POINTS - 1 : waveIdx - 1;
  int lastVal = constrain(buf[lastIdx], 0, 100);
  
  tft.setTextSize(1);
  tft.setTextColor(color);
  tft.fillRect(drawX + 1, drawY + 1, 30, 10, 0x18C3);
  tft.drawString(String(lastVal) + "%", drawX + 2, drawY + 2);
  tft.setTextColor(TFT_WHITE);
}

void drawMainUI() {
  int col1X = 5;
  int col2X = 165;
  int startY = 32;
  int lineH = 18;
  int waveY = startY + lineH * 4 + 4;
  int waveH = 56;
  int bottomY = waveY + waveH + 14;
  
  // ===== 更新蓝牙状态 =====
  static bool lastBleState = false;
  if (firstRun || lastBleState != bleConnected) {
    tft.fillRect(258, 2, 60, 22, 0x1082);
    
    uint16_t dotColor = bleConnected ? TFT_GREEN : TFT_RED;
    tft.fillCircle(270, 14, 4, dotColor);
    for (int r = 5; r < 8; r++) {
      tft.drawCircle(270, 14, r, dotColor);
    }
    
    tft.setTextSize(1);
    tft.setTextColor(TFT_WHITE);
    tft.drawString(bleConnected ? "ON" : "OFF", 280, 9);
    
    lastBleState = bleConnected;
  }
  
  // ===== CPU =====
  if (firstRun || lastData.cpuLoad != dataPack.cpuLoad || 
      lastData.cpuTemp != dataPack.cpuTemp) {
    tft.fillRect(col1X + 48, startY + lineH, 100, 16, TFT_BLACK);
    tft.setTextColor(TFT_GREEN);
    tft.drawString(String(dataPack.cpuLoad, 1) + "%", col1X + 48, startY + lineH);
    tft.setTextColor(TFT_WHITE);
    tft.drawString(String(dataPack.cpuTemp, 1) + "C", col1X + 48 + 48, startY + lineH);
  }
  
  if (firstRun || lastData.cpuFan != dataPack.cpuFan) {
    tft.fillRect(col1X + 48, startY + lineH * 2, 100, 16, TFT_BLACK);
    tft.setTextColor(TFT_CYAN);
    tft.drawString(String(dataPack.cpuFan, 0) + " RPM", col1X + 48, startY + lineH * 2);
    tft.setTextColor(TFT_WHITE);
  }
  
  if (firstRun || lastData.cpuPower != dataPack.cpuPower) {
    tft.fillRect(col1X + 48, startY + lineH * 3, 100, 16, TFT_BLACK);
    tft.setTextColor(TFT_YELLOW);
    tft.drawString(String(dataPack.cpuPower, 1) + " W", col1X + 48, startY + lineH * 3);
    tft.setTextColor(TFT_WHITE);
  }
  
  drawWaveGraph(col1X, waveY, 150, waveH, cpuWave, lastCpuWave, TFT_GREEN);
  
  // ===== GPU =====
  if (firstRun || lastData.gpuLoad != dataPack.gpuLoad || 
      lastData.gpuTemp != dataPack.gpuTemp) {
    tft.fillRect(col2X + 48, startY + lineH, 100, 16, TFT_BLACK);
    tft.setTextColor(TFT_RED);
    tft.drawString(String(dataPack.gpuLoad, 1) + "%", col2X + 48, startY + lineH);
    tft.setTextColor(TFT_WHITE);
    tft.drawString(String(dataPack.gpuTemp, 1) + "C", col2X + 48 + 48, startY + lineH);
  }
  
  if (firstRun || lastData.gpuMem != dataPack.gpuMem) {
    tft.fillRect(col2X + 48, startY + lineH * 2, 100, 16, TFT_BLACK);
    tft.setTextColor(TFT_MAGENTA);
    tft.drawString(String(dataPack.gpuMem, 2) + " GB", col2X + 48, startY + lineH * 2);
    tft.setTextColor(TFT_WHITE);
  }
  
  if (firstRun || lastData.gpuPower != dataPack.gpuPower) {
    tft.fillRect(col2X + 48, startY + lineH * 3, 100, 16, TFT_BLACK);
    tft.setTextColor(TFT_YELLOW);
    tft.drawString(String(dataPack.gpuPower, 1) + " W", col2X + 48, startY + lineH * 3);
    tft.setTextColor(TFT_WHITE);
  }
  
  drawWaveGraph(col2X, waveY, 150, waveH, gpuWave, lastGpuWave, TFT_RED);
  
  // ===== 底部 =====
  if (firstRun || lastData.memUsed != dataPack.memUsed) {
    tft.fillRect(col1X + 42, bottomY, 105, 16, TFT_BLACK);
    tft.setTextColor(TFT_CYAN);
    tft.drawString(String(dataPack.memUsed, 1) + "%", col1X + 42, bottomY);
    tft.setTextColor(TFT_WHITE);
    
    int barLen = map((int)dataPack.memUsed, 0, 100, 0, 40);
    uint16_t barColor = (dataPack.memUsed > 80) ? TFT_RED : 
                        (dataPack.memUsed > 60) ? TFT_YELLOW : TFT_CYAN;
    tft.fillRect(col1X + 85, bottomY + 3, barLen, 10, barColor);
    tft.drawRect(col1X + 85, bottomY + 3, 40, 10, TFT_DARKGREY);
  }
  
  if (firstRun || lastData.hddTemp != dataPack.hddTemp) {
    tft.fillRect(col1X + 42, bottomY + lineH, 105, 16, TFT_BLACK);
    tft.setTextColor(TFT_ORANGE);
    tft.drawString(String(dataPack.hddTemp, 1) + "C", col1X + 42, bottomY + lineH);
    tft.setTextColor(TFT_WHITE);
  }
  
  if (firstRun || lastData.fps != dataPack.fps) {
    tft.fillRect(col2X + 35, bottomY, 110, 16, TFT_BLACK);
    uint16_t fpsColor = (dataPack.fps > 120) ? TFT_GREEN : 
                        (dataPack.fps > 60) ? TFT_YELLOW : TFT_RED;
    tft.setTextColor(fpsColor);
    tft.drawString(String(dataPack.fps, 0) + " FPS", col2X + 35, bottomY);
    tft.setTextColor(TFT_WHITE);
  }
  
  if (firstRun) {
    firstRun = false;
  }
  lastData = dataPack;
}