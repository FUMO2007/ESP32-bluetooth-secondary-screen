# ============================================================================
#  .gitignore —— 什么该入库、什么不该
# ----------------------------------------------------------------------------
#  原则：**可再生的东西一律不入库**（构建产物、缓存、日志、渲染出来的位图）；
#  例外是"别人从源码构建也需要"的第三方二进制与文档用的预览图，见文件末尾。
#
#  这些东西以前全都在工作区里躺着，判断"哪份是最新的"只能看时间戳 ——
#  也就是 deploy.ps1 头部说的"两边悄悄分叉"的病根之一。
# ============================================================================

# ---- 构建产物（build.ps1 每次重新生成，产物目录固定 build_out/）----
build_out/
tools/ui_preview/*.exe
tools/ui_preview/*.bmp

# ---- 打包产物（dist/pc_monitor_libre.exe）----
# **故意不入库**：它是 17 MB 的二进制，每次重新打包提交一次就会往 git 历史里
# 永久再加 17 MB，而且改一行 PC 端代码就多一份。发布走 GitHub Releases ——
# Release 的附件不占 git 历史。取得方式见 README 的"打包好的 exe"。
# （曾经入库过一次，已在推送前撤出。）
dist/

# ---- test_pc_side.py 在崩溃/中断时残留的临时目录 ----
mei_*/
local_*/

# ---- Python 缓存 ----
__pycache__/
*.pyc
*.pyo

# ---- 运行日志与测试快照 ----
*.log
report.txt
test_out.txt

# ---- 本机配置（入库的是模板 pc_monitor.ini.sample）----
pc_monitor.ini

# ---- 第三方二进制：deploy.ps1 的可选同步源，不入库 ----
# LibreHardwareMonitor 的托管 DLL 集合（约 5 MB）。放在这里就会被 deploy.ps1
# 同步到运行目录；不放也行，只要运行目录里已有那份。README 说明了从哪来。
dlls/

# ---- 时间戳备份 ----
# 项目以前用 *.bak_<标签>_<时间戳> 充当"分支"，现在交给 git：
#      git switch -c stage/<标签>
# 要保留某个版本的现场就开分支，不要再复制文件（复制出来的那份永远没人清理）。
*.bak
*.bak_*

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ============================================================================
#  下面这些**故意不忽略**，别顺手加进来：
#    vendor/PresentMon-2.6.0-x64.exe   真帧率的唯一来源，spec 会打进 exe（MIT，可分发）
#    tools/ui_preview/*.png            README 引用的页面预览图（几 KB）
#    tools/ui_preview/golden_vectors.h 跨语言金标契约，由 test_proto.py 生成并校验
#    libraries/TFT_eSPI/               固件构建依赖它（**但 examples/ 已删除**，见下）
# ============================================================================

# 关于 libraries/TFT_eSPI/examples/：
#   上游库自带 313 个示例文件、28.6 MB，占整个 vendored 库的 89%，而本项目
#   **一个都不会编译** —— tft_setup.h 用 USER_SETUP_ID 让库优先加载 sketch 目录下的
#   配置，编译只取库根 + Processors + Fonts + TFT_Drivers + Extensions。
#   所以删掉了它们（仓库 62 MB -> 约 22 MB，跟踪文件 652 -> 339）。
#   原始快照留在本地分支 `backup-tft-espi-examples` 里，需要时可取回；
#   也可以直接从上游 https://github.com/Bodmer/TFT_eSPI 的 v2.5.43 tag 重新下载。
